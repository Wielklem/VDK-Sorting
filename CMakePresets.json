{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VSORT_BUILD_HMI": "ON",
        "VSORT_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic" }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    { "name": "linux-debug",   "inherits": "linux-base",   "displayName": "Linux Debug",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-release", "inherits": "linux-base",   "displayName": "Linux Release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "linux-service-debug", "inherits": "linux-debug", "displayName": "Linux Debug, service only (no Qt)", "cacheVariables": { "VSORT_BUILD_HMI": "OFF" } },
    { "name": "linux-galaxy-debug", "inherits": "linux-service-debug", "displayName": "Linux Debug, service only + Daheng adapter (needs GALAXY_SDK_ROOT)", "cacheVariables": { "VSORT_WITH_GALAXY": "ON" } },
    { "name": "windows-debug",   "inherits": "windows-base", "displayName": "Windows Debug",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "windows-release", "inherits": "windows-base", "displayName": "Windows Release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "linux-debug",         "configurePreset": "linux-debug" },
    { "name": "linux-release",       "configurePreset": "linux-release" },
    { "name": "linux-service-debug", "configurePreset": "linux-service-debug" },
    { "name": "linux-galaxy-debug", "configurePreset": "linux-galaxy-debug" },
    { "name": "windows-debug",       "configurePreset": "windows-debug" },
    { "name": "windows-release",     "configurePreset": "windows-release" }
  ],
  "testPresets": [
    { "name": "linux-debug",         "configurePreset": "linux-debug",         "output": { "outputOnFailure": true } },
    { "name": "linux-release",       "configurePreset": "linux-release",       "output": { "outputOnFailure": true } },
    { "name": "linux-service-debug", "configurePreset": "linux-service-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-galaxy-debug", "configurePreset": "linux-galaxy-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-debug",       "configurePreset": "windows-debug",       "output": { "outputOnFailure": true } },
    { "name": "windows-release",     "configurePreset": "windows-release",     "output": { "outputOnFailure": true } }
  ]
}
